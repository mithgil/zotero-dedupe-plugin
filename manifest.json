{
  "manifest_version": 2,
  "name": "Zotero Dedupe",
  "version": "1.2.0",
  "description": "Local duplicate-check endpoint for the Zotero Dedupe browser extension.",
  "author": "Tim",
  "applications": {
    "zotero": {
      "id": "zotero-dedupe@example.com",
      "update_url": "https://example.com/zotero-dedupe/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "11.*"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
